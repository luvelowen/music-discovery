# To send real emails, copy this file to .env.local and fill in the last two lines THERE.
# Never put a real password in this file: it is uploaded to GitHub. .env.local never is.
#
# For Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
# It is a separate 16-letter password. Never use your normal Gmail password.
# While these are empty, emails are written to data/outbox on this computer.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Who runs the app. Shown on the Privacy page.
# Once APP_HOSTS is set (a public address), nobody can sign up until all three are filled in.
APP_OPERATOR=
APP_CONTACT=
APP_DATA_LOCATION=
# The public address without https://, for example app.example.mn. Leave empty on your own computer.
APP_HOSTS=
